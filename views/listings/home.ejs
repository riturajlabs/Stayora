<% layout("/layouts/boilerplate.ejs") -%>

<body>
  <!-- Filters Section -->
  <div id="filters" class="d-flex flex-row overflow-auto py-2 px-2">
      <a href="/listing?category=Trending" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-fire fa-lg"></i></div>
        <p class="mb-0">Trending</p>
      </a>
      <a href="/listing?category=Rooms" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-bed fa-lg"></i></div>
        <p class="mb-0">Rooms</p>
      </a>
      <a href="/listing?category=Iconic Cities" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-mountain-city fa-lg"></i></div>
        <p class="mb-0">Iconic Cities</p>
      </a>
      <a href="/listing?category=Mountain" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-mountain fa-lg"></i></div>
        <p class="mb-0">Mountain</p>
      </a>
      <a href="/listing?category=Castles" class="filter text-center mx-2 mb-2">
        <div><i class="fa-brands fa-fort-awesome fa-lg"></i></div>
        <p class="mb-0">Castles</p>
      </a>
      <a href="/listing?category=Amazing Pools" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-person-swimming fa-lg"></i></div>
        <p class="mb-0">Amazing Pools</p>
      </a>
      <a href="/listing?category=Arctic" class="filter text-center mx-2 mb-2">
        <div><i class="fa-regular fa-snowflake fa-lg"></i></div>
        <p class="mb-0">Arctic</p>
      </a>
      <a href="/listing?category=Farms" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-plate-wheat fa-lg"></i></div>
        <p class="mb-0">Farms</p>
      </a>
      <a href="/listing?category=Campaign" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-campground fa-lg"></i></div>
        <p class="mb-0">Campaign</p>
      </a>
      <a href="/listing?category=Dome" class="filter text-center mx-2 mb-2">
        <div><i class="fa-solid fa-igloo fa-lg"></i></div>
        <p class="mb-0">Dome</p>
      </a>

        <!-- Tax Toggle -->
        <div class="tax-toggle ms-auto  align-items-center">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input " type="checkbox" id="checkNativeSwitch">
                <label class="form-check-label" for="checkNativeSwitch">
                Display total after taxes
                </label>
            </div>
        </div>
  </div>

  <!-- Listings Grid -->
  <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5">

    <% for(let list of listings){ %>
      <div class="col">
        <a class="list-card text-decoration-none" href="/listing/<%= list._id %>">
          <div class="card listing-card h-100">
            <img src="<%= list.image.url %>" class="card-img-top img-fluid rounded-top" alt="<%= list.title %>">
            <div class="card-body">
              <p class="card-text mb-0">
                <b><%= list.title %></b><br>
                &#8377;<%= list.price ? list.price.toLocaleString("en-IN") : "Price not available" %> / night
                <i class="tax-info">&nbsp;+18% GST</i>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% } %>

  </div>
</body>