<% layout("/layouts/boilerplate.ejs") -%>

<script>
    window.coordinates = <%- JSON.stringify(data.geometry.coordinates) %>;
    window.mapLocation = "<%= data.title %>";
</script>

<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <h2 class="mb-2 show-title"><%= data.title %></h2>

      <img class="show-image img-fluid mb-3" src="<%= data.image.url %>" alt="listing image">

      <div class="show-details mb-4">
        <p >
          <%- data.description.replace(/\n/g, '<br>') %><br><br>
          <strong>&#8377;<%= data.price ? data.price.toLocaleString("en-IN") : "Price not available" %></strong>
          <br>
          <%= data.location %>, <%= data.country %>
        </p>
        <p class="host-info"><b>Hosted by <%= data.owner.firstName %> <%= data.owner.lastName %></b></p>
      </div>

      <!-- Edit / Delete Buttons -->
      <% if(currUser && currUser._id.equals(data.owner._id)){ %>
        <div class="d-flex flex-wrap gap-2 mb-4">
          <form method="GET" action="/listing/<%= data._id %>/edit">
            <button class="btn btn-danger rounded-pill px-4">Edit</button>
          </form>
          <form method="POST" onsubmit="return confirm('⚠️ Do you really want to delete this listing?')" action="/listing/<%= data._id %>/?_method=DELETE">
            <button class="btn btn-outline-dark rounded-pill px-4">Delete</button>
          </form>
        </div>
      <% } %>

      <hr class="my-4">

      <!-- Review Form -->
      <% if(currUser){ %>
        <form method="POST" action="/listing/<%= data._id %>/reviews" class="needs-validation mb-4" novalidate>
          <h4 class="mb-3">Leave your Feedback</h4>

          <div class="mb-3">
            <label class="form-label">Rating:</label>
            <div class="star-rating">
              <% for(let i=1; i<=5; i++){ %>
                <input type="radio" name="reviews[rating]" value="<%= i %>" id="<%= i %>">
                <label for="<%= i %>"><i class="bi bi-star-fill"></i></label>
              <% } %>
            </div>
          </div>

          <div class="mb-3">
            <label for="comments" class="form-label">Feedback:</label>
            <textarea name="reviews[comments]" id="comments" rows="5" class="form-control rounded-3" required></textarea>
            <div class="invalid-feedback">Please enter comments for the review.</div>
          </div>

          <button class="btn btn-primary rounded-pill px-4">Submit</button>
        </form>
        <hr class="my-4">
      <% } %>

      <!-- Reviews Section -->
      <div class="reviews-section">
        <% if(data.reviews && data.reviews.length > 0 ){ %>
            
          <h4 class= "mb-3">All Reviews</h4>

          <div id="reviews-container" class="row g-3">
            <% data.reviews.forEach((review, index) => { %>
              <div class="col-12 col-md-6 review-item" style="<%= index >= 6 ? 'display:none;' : '' %>">
                <div class="card review-card h-100 shadow-sm rounded-3 px-2 py-2">
                  <div class="card-body">
                    <h5>@<%= review.author.firstName %> <%= review.author.lastName %></h5>
                    <div class="info mb-2">
                      <span class="rating"><%= "★".repeat(review.rating) %><%= "☆".repeat(5-review.rating) %></span>
                      <span class="dot"></span>
                      <span class="date"><%= review.createdAt.toLocaleDateString("en-IN",{month:"long", year:"numeric"}) %></span>
                    </div>

                    <p class="card-text review-text">
                      <% if(review.comments.length > 140){ %>
                        <span class="short-text"><%= review.comments.substring(0,120) %>...</span>
                        <span class="full-text" style="display:none;"><%= review.comments %></span>
                        <button class="read-more-btn btn p-0">Show More</button>
                      <% } else { %>
                        <%= review.comments %>
                      <% } %>
                    </p>

                    <% if(currUser && review.author._id.equals(currUser._id)){ %>
                      <form method="POST" action="/listing/<%= data._id %>/reviews/<%= review._id %>/?_method=DELETE" onsubmit="return confirm('⚠️ Are you sure your really wants to delete this review?')">
                        <button class="btn btn-outline-dark rounded-3 mt-3">Delete</button>
                      </form>
                    <% } %>

                  </div>
                </div>
              </div>
            <% }) %>
          </div>

          <% if(data.reviews.length > 6){ %>
            <div class="text-center mt-3">
              <button id="toggle-reviews" class="show-all-reviews">Show all <%= data.reviews.length %> reviews</button>
            </div>
          <% } %>
          <br><hr><br>
        <% } %>
      </div>

      <!-- Map -->
      <div>
        <h3>Where you’ll be</h3>
        <p class="map-par"><%= data.location %>, <%= data.country %></p>
        <div id="map" class="mt-1"></div>
      </div>

    </div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
    const toggleBtn = document.getElementById('toggle-reviews');
    if(toggleBtn){
        let showingAll = false;
        toggleBtn.addEventListener('click', () => {

            const hiddenReviews = document.querySelectorAll('.review-item');
            hiddenReviews.forEach((item, index) => {

                if(index >= 6) item.style.display = showingAll ? 'none' : 'block';
            });

            toggleBtn.textContent = showingAll ? 'Show all <%= data.reviews.length %> reviews' : 'Show Less Reviews';
            showingAll = !showingAll;

        });
    }

    const readMoreButtons = document.querySelectorAll('.read-more-btn');
    readMoreButtons.forEach(btn => {

        btn.addEventListener('click', () => {

            const shortText = btn.previousElementSibling.previousElementSibling;
            const fullText = btn.previousElementSibling;
            if(fullText.style.display === 'none'){

                fullText.style.display = 'inline';
                shortText.style.display = 'none';
                btn.textContent = 'Read Less';

            } else {

                fullText.style.display = 'none';
                shortText.style.display = 'inline';
                btn.textContent = 'Read More';

            }
        });
    });
});
</script>